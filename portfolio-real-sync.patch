+  const bottomRef = useRef<HTMLDivElement>(null);
+
+  // Initial welcome message
+  useEffect(() => {
+    if (isOpen && history.length === 0) {
+      setHistory([
+        {
+          id: 'welcome',
+          command: 'init',
+          timestamp: new Date().toLocaleTimeString(),
