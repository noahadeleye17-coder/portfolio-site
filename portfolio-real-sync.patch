+        setTimeout(() => {
+          onClose();
+          onOpenResume();
+        }, 500);
+        break;
+
+      case 'theme':
+        onToggleTheme();
+        output = <p className="text-xs text-amber-300 font-mono">Theme toggled successfully.</p>;
+        break;
+
+      case 'sudo hire':
+      case 'hire':
+        output = (
+          <div className="p-3 rounded-lg bg-emerald-950/60 border border-emerald-800 text-xs text-emerald-300 font-mono space-y-2">
